#!name = 小红书净化
#!desc = 首页信息流过滤, 首页Tab可编辑, 同城净化, 复制下载解锁, 视频流阻止下滑
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png

# 小红书净化 — Loon
# 本插件主要为自用，不接受功能性修改，请支持原作者

# ===== 用户参数 =====
# 屏蔽分类：用空格分隔 category_name（不要用逗号，会截断配置行）
# 分类名见 docs/XIAOHONGSHU_REFERENCE.md
[Argument]
dailyLimit = input,"0",tag=首页·日浏览上限(0=不限)
# 首页分类三档：注入并过滤 / 只注入(不删帖) / 不注入(分类相关全关)。默认第一项。
# 只影响「分类」这一路，filterVideo 与 dailyLimit 是独立开关。
showCategoryInTitle = select,"注入并过滤","只注入","不注入",tag=首页·分类名注入与过滤
blockCategories = input,"科技数码 二次元 娱乐 资讯 汽车 游戏 人文 职场 商业财经",tag=首页·过滤特定分类(空格分隔)
filterVideo = switch,true,tag=首页·过滤视频卡片
# 热点/直播是混在信息流里的非笔记卡片，与「过滤视频卡片」各管各的。默认第一项(两者都过滤)。
blockFeedCards = select,"热点和直播","直播","热点","都不过滤",tag=首页·过滤热点与直播
blockVideoScroll = switch,true,tag=视频流·阻止下滑下一个
filterLocalfeedExhausted = switch,true,tag=同城·丢弃非同城内容

# ===== 脚本 =====

[Script]

# 首页信息流 — 请求强制 gzip（默认 br，不解压脚本失效）
http-request ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v6/homefeed(\?|$) script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, tag=XHS-首页请求-gzip

# 首页信息流 — 响应过滤（删视频帖/黑名单分类）
http-response ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v6/homefeed(\?|$) script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, requires-body=1, argument=[{blockCategories},{dailyLimit},{filterVideo},{blockFeedCards},{showCategoryInTitle}], tag=XHS-首页过滤

# 首页顶部分类 Tab — 把固定 tab(RED/直播/短剧等 fixed:true)改成可编辑
http-response ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v6/homefeed/categories script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, requires-body=1, tag=XHS-首页Tab可编辑

# 同城信息流 — 请求强制 gzip + 响应丢弃已刷完的填充内容
http-request ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v1/localfeed\? script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, tag=XHS-同城请求-gzip
http-response ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v1/localfeed\? script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, requires-body=1, argument=[{filterLocalfeedExhausted}], tag=XHS-同城过滤

# 笔记详情 — 解除复制/下载限制
http-request ^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v\d+/note/imagefeed script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, tag=XHS-笔记请求-gzip
http-response ^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v\d+/note/imagefeed script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, requires-body=1, tag=XHS-笔记解锁

# 视频流 — 解除限制 + 阻止下滑
http-request ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v\d+/note/videofeed\? script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, tag=XHS-视频流请求-gzip
http-response ^https?://rec\.(?:xiaohongshu|rnote)\.com/api/sns/v\d+/note/videofeed\? script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/XHSClean.js, requires-body=1, argument=[{blockVideoScroll}], tag=XHS-视频流解锁

# ===== 商城/广告域名（连接层拒绝）=====

[Rule]

DOMAIN,mall.xiaohongshu.com,REJECT
DOMAIN,mall.rnote.com,REJECT
DOMAIN-SUFFIX,admobile.top,REJECT

# ===== MITM =====
# 国内账号走 *.xiaohongshu.com；Google/海外账号登录后 App 整体切到 *.rnote.com（RedNote），
# 接口路径完全相同，只有 host 变了 —— 两套都要 MITM + 正则兼容，否则静默失效。

[MITM]
hostname = rec.xiaohongshu.com, edith.xiaohongshu.com, rec.rnote.com, edith.rnote.com
