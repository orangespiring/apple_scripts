#!name=Bilibili 去广告+信息流净化
#!desc=去广告, 首页信息流五档可选（默认/过滤/改稍后再看/空白）, 搜索页相关性过滤+最多显示n条, 播放页过滤信息流, 空降助手
#!author=@orangespiring；gRPC/JSON 去广告脚本基于 kokoryh/Sparkle[https://github.com/kokoryh/Sparkle]
#!openUrl=https://apps.apple.com/app/id736536022
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://github.com/orangespiring
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!date=2026-08-15

# 哔哩哔哩净化 — Loon
# 核心 gRPC 去广告基于 kokoryh/Sparkle，本插件主要为自用，不接受功能性修改，请支持原作者：
# https://github.com/kokoryh/Sparkle
# 规则与脚本部分参考 fmz200/wool_scripts

[Argument]
# —— 本插件独有 ——
homeShow = select,"默认信息流","过滤信息流","改稍后再看（随机）","改稍后再看","空白界面",tag=首页·信息流模式,desc=只控制 feed/index 的内容 —— 默认信息流（默认）：完全不动 B 站的推荐流，下面「过滤信息流」与「屏蔽词」两个参数一概不生效；过滤信息流：仍是 B 站的推荐流，但下面两个参数生效（去广告／去直播／去竖屏／去图文／时长下限／[话题]标题前缀／精简顶栏／每天推送n次／屏蔽词）；改稍后再看（随机）：首页换成「稍后再看」列表（需登录）并在每次下拉刷新时重新洗牌；改稍后再看：同上但按 B 站默认顺序；空白界面：首页信息流恒空。顶栏是否只留一个 tab 由「精简顶栏」决定（默认信息流档不生效）；折叠后的名字随模式变（改稍后再看两档=「稍后再看」／空白界面=「首页」／过滤信息流=不改名）。右上角入口与底栏精简恒开、不受影响
homeFeedFilter = input,"去广告(1) 去直播(1) 去竖屏(1) 去图文(1) 去番剧纪录片(1) 过滤(240)秒以下 标签前缀(1) 精简顶栏(1) 每天推送(3)次 //括号里1=开 0=关 秒那项填秒数",tag=首页·过滤信息流,desc=⚠️只在「信息流模式＝过滤信息流」时生效，模式选「默认信息流」时整个参数不起作用。一个文本框管一串开关，括号里的数字就是取值：开关类 1=开／0=关；「秒」那条填秒数（0=不按时长丢）。「标签前缀」=标题前加上 B 站给这条视频贴的话题名，形如 [杀戮尖塔2] 标题…，没写也按开，要关就显式写 标签前缀(0)；「精简顶栏」=首页顶栏只留一个 tab（移除 热门／直播／追番等），没写时不折叠；「每天推送(n)次」=一天最多给 n 屏内容，每屏只在冷启动那一下给、会话内下拉刷新与上滑加载都不再出新内容，次日重置；0=不启用（照常无限刷）。// 或 # 之后当注释，可以自己写备注。括号全角半角都行，去广告=1 或 去广告：1 也认；空格、逗号、顿号、分号、换行都能分隔；「去番剧纪录片」=丢掉 B 站的 PGC 卡（番剧／纪录片／电影／电视剧，card_goto=bangumi），⚠️结构上分不出子类型，开了就是整类都丢；只想滤纪录片就别开它，改用下面的屏蔽词写 up:哔哩哔哩纪录片。只按关键词识别（广告／直播／竖屏／图文／番剧或纪录片／秒／标签／顶栏／推送），措辞随便改；整串留空=全不过滤
homeBlockWords = input,"//空格分隔多个词 命中标题/UP名/话题标签就丢 加前缀可只匹配一处 title: up: tag:",tag=首页·屏蔽词,desc=空格分隔多个词，默认「标题／UP名／话题标签」三处任一命中就丢掉这条。想只匹配一处就加前缀：title:测评 只看标题、up:某某UP 只看UP名、tag:石头A30 只看话题标签（中文 标题:／up主:／标签: 也认）。子串匹配、不区分大小写；// 或 # 之后当注释（默认值就是一句注释，等于不屏蔽）；留空=不屏蔽。⚠️只在「信息流模式＝过滤信息流」时生效，模式选「默认信息流」时本参数不起作用。⚠️话题标签是 B 站给这条推荐贴的**一个**话题名，不是视频详情页那种多标签，也不是一级分区。作用范围同上：只管原生推荐流
# —— 常规净化 ——
cleanSearch = switch,true,tag=搜索页·相关性过滤,desc=视频卡须标题/UP名/热评命中搜索词才留（去广告恒开；课程/番剧/用户卡放行）
searchMaxItems = input,"15",tag=搜索页·最多显示n条,desc=一次搜索最多给这么多条（默认 15）；数满后继续上滑不再加载新结果。与上面的相关性过滤联动＝先丢掉不相关的、再取前 n 条，所以实际条数可能不足 n。0 或留空=不限条数。换个词搜、或距上次搜索超过 10 分钟会自动重新计数
searchMinDur = input,"0",tag=搜索页·过滤<n秒的视频,desc=填秒数，短于它的视频卡丢弃；0 或留空=不按时长丢（默认）。也认 "1:30" 这种写法，前后空格/换行会自动去掉
cleanMine = switch,true,tag=我的页·精简
cleanSplash = switch,true,tag=开屏·广告列表清空
displayUpList = select,"show","hide","auto",tag=动态·[最常访问]显示方式
purifyComment = switch,true,tag=评论区·过滤置顶广告,desc=只管 UP 主置顶的那条恰饭评论 + 评论区顶部广告卡；评论列表本体不动
optimizeRequest = switch,false,tag=评论区·加载优化
cleanRelates = switch,true,tag=播放·清空推荐列表 (和'加载优化'冲突),desc=连正常视频推荐一起清空（关=仅去广告、保留推荐）
sponsorBlock = switch,true,tag=播放·空降助手（跳过赞助段）
logLevel = select,"error","warn","info","debug","off",tag=脚本日志等级,desc=默认 error（只报异常）。调到 debug 能在 Loon 日志里看到 [HWL]/[SC]/[SPL]/[SearchAll] 各脚本的逐条统计，排查时再开

# ===== 网络层（无需 MITM）=====
[Rule]
URL-REGEX,^http://upos-sz-static\.bilivideo\.com/ssaxcode/\w{2}/\w{2}/\w{32}-1-SPLASH,REJECT-DICT
URL-REGEX,^http://[\d\.]+:8000/v1/resource/\w{32}-1-SPLASH,REJECT-DICT
# cm.bilibili.com = 商业广告域名（/cm/api/fees/wise 广告调度、/cm/api/conversion 归因）；
#   注：播放页可见的视频下广告是 protobuf 里的 cm 字段，由脚本删除，不靠这条。
DOMAIN,cm.bilibili.com,REJECT

# 广告「自动点击」用的第三方上报域名（`176_` 实测，纪录片详情页自动跳转的实锤）：
#   时间线是 cm/api/fees/wise(广告调度) → ad/click(第三方点击上报) → cm/api/conversion/mobile/v2(归因)
#   → cm/mgk/.../landing_pages(落地页) → 被推广的 App 被拉起。用户没点，它自己发的。
#   ad-api.morefreegame.com/app/ad/click 带全套设备指纹（idfa_md5/caid/ad_creative_id，
#   ad_channel=DSP_BILI_GMZZ_IOS_WD_21）；cid-click.smallfighter.com/cid/click 是另一个点击追踪。
#   ⚠️ 这两条只是掐掉**上报**；卡片本身不渲染才是治本，靠 gRPC 脚本删广告模块。
DOMAIN-SUFFIX,morefreegame.com,REJECT
DOMAIN-SUFFIX,smallfighter.com,REJECT

# ===== 脚本 =====
[Script]

# — 首页信息流模式（feed/index → 默认/过滤/改稍后再看/空白，见 homeShow；过滤各项与投放节奏见 homeFeedFilter）—
#   ⚠️ 恒开、不能用 enable={homeShow} 门控：enable= 只认 true/false，select 给的是中文档名
#      → 每一档都会被判成 false、脚本永不执行。「默认信息流」这一档由脚本内部原样放行。
http-response ^https?://app\.bili(?:bili\.com|api\.net)/x/v2/feed/index script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliHome.js, requires-body=1, argument=[{homeShow},{homeFeedFilter},{homeBlockWords}], tag=B站·首页信息流模式

# — tab/v2 接管（恒开：右上角入口 data.top + 底栏精简 + 删「…」菜单 恒改；顶栏 tab 是否折叠由 homeFeedFilter 的「精简顶栏」+ homeShow 模式共同决定，两个参数都要传）—
#   Loon 同 URL「最后一个脚本整体覆盖、各自读原始响应」(§13b)，故 tab/v2 只能由单一脚本接管，全部并入本脚本。
http-response ^https?://app\.bili(?:bili\.com|api\.net)/x/resource/show/tab/v2 script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliHome.js, requires-body=1, argument=[{homeShow},{homeFeedFilter}], tag=B站·首页顶底栏改造

# — 我的页精简 —
http-response ^https?://app\.bili(?:bili\.com|api\.net)/x/v2/account/(?:mine|myinfo) script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliMineClean.js, requires-body=1, enable={cleanMine}, tag=B站·我的页精简

# — 开屏广告列表 —
http-response ^https?://app\.bili(?:bili\.com|api\.net)/x/v2/splash/list script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliSplashBlock.js, requires-body=1, enable={cleanSplash}, tag=B站·开屏广告列表

# — gRPC 去广告 + 播放页推荐（fork 自 Sparkle）—
# 覆盖：DynAll / Popular / View / ViewProgress / RelatesFeed / PlayView / PlayViewUnite / SearchAll / DmView / MainList / PGC PlayView
http-response ^https://(?:grpc\.biliapi\.net|app\.bili(?:bili\.com|api\.net))/bilibili\.(?:app\.(?:show\.v1\.Popular/Index|dynamic\.v2\.Dynamic/DynAll|view(?:unite)?\.v1\.View/(?:View|ViewProgress|RelatesFeed)|playurl\.v1\.PlayURL/PlayView|playerunite\.v1\.Player/PlayViewUnite)|polymer\.app\.search\.v1\.Search/SearchAll|community\.service\.dm\.v1\.DM/DmView|main\.community\.reply\.v1\.Reply/MainList|pgc\.gateway\.player\.v2\.PlayURL/PlayView)$ script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliProtobufResponse.js, requires-body=true, binary-body-mode=true, argument=[{displayUpList},{purifyComment},{sponsorBlock},{cleanRelates},{cleanSearch},{searchMaxItems},{searchMinDur},{logLevel}], tag=B站·gRPC去广告+播放页推荐

# ===== 请求阶段短路（不发上游，2026-09-08 新增）=====
# ⚠️ 为什么要有这一段：[Script] 型改写**一分下行都省不到** —— Loon 把整个响应体下完才交给脚本。
#    179_ 铁证：RelatesFeed 的 _loon.downloadSize=29,217 而 content.size=21；
#              splash/list 的 downloadSize≈30,512 而 content.size=250。
#    真正不发上游的只有 reject-* / mock-response-body / http-request 里的 $done({response})。
# ⚠️ 下面每一条对应的 http-response 规则都**保留不动**，那是失败模式安全网：万一 Loon 忽略
#    response 键，请求照常走上游、由响应脚本兜底，只是没省到流量，不会挂。
# 判据：HAR 里这些条目的 _loon.downloadSize 为 0、serverIPAddress 为空 = 真短路了。

# 首页信息流：只短路「每天推送(n)次」配额用完后的三类请求（加载更多 / 会话内刷新 / 冷启动回放），
#   它们的输出与服务器返回什么无关。判据 open_event/pull/idx/column 全在 URL query 里。
#   恒开（同上方 feed/index 那条：select 参数不能用 enable= 门控），脚本内自己判该不该放行。
http-request ^https?://app\.bili(?:bili\.com|api\.net)/x/v2/feed/index script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliHome.js, argument=[{homeShow},{homeFeedFilter},{homeBlockWords}], tag=B站·首页信息流·请求阶段短路

# 开屏广告列表：输出恒为「成功但无广告」，与服务器返回什么无关 → 整条短路。
http-request ^https?://app\.bili(?:bili\.com|api\.net)/x/v2/splash/list script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliSplashBlock.js, enable={cleanSplash}, tag=B站·开屏广告列表·请求阶段短路

# 播放页「相关推荐」下滑加载更多：cleanRelates=on 时响应脚本把 relates 清成 []，整条请求白发。
#   ⚠️ 返回的 5 字节空帧**不带分页游标** —— 原先清空却把游标(base64 "relate3/4/5"，逐页递增)
#      还回去，App 以为还有下一页继续翻（34_ 里同一视频连发 3 次、共 57,406 B 全下完即丢）。
#   不需要 requires-body：这条无条件短路，不读请求体。
http-request ^https://(?:grpc\.biliapi\.net|app\.bili(?:bili\.com|api\.net))/bilibili\.app\.viewunite\.v1\.View/(?:RelatesFeed|AIRelateAsync)$ script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliShortCircuit.js, enable={cleanRelates}, tag=B站·相关推荐·请求阶段短路

# 搜索结果翻页：只短路 searchMaxItems 配额用完之后的翻页（第 1 页永远放行）。
#   判据在请求体 protobuf 里（f10 分页消息有无 cursor），故需要 binary-body-mode 读请求体。
http-request ^https://(?:grpc\.biliapi\.net|app\.bili(?:bili\.com|api\.net))/bilibili\.polymer\.app\.search\.v1\.Search/SearchAll$ script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliShortCircuit.js, requires-body=true, binary-body-mode=true, argument=[{searchMaxItems},{logLevel}], tag=B站·搜索翻页·请求阶段短路

# 播放页「相关视频」的真正来源 AIRelateAsync（2026-09-08 改由脚本接管，此前是恒开的 mock 空帧）。
#   一个响应装两样：f1=广告块 AdsControlDto（openapp 唤起白名单 / adtrack.qianwen 上报），
#   f2→f1→f22(Relates)→卡列表。`176_` 实测 11 张卡里 1 张是 CM_TYPE 广告。
#   · cleanRelates=on  → 上面那条请求规则已把它短路成空帧，本条跑不到（省 ~28 KB/次）
#   · cleanRelates=off → 走本条：**删 f1 + 滤掉 {4,5,6,7,11} 类广告卡**，正常推荐一张不少
#   ⚠️ 本条**故意不带 enable=**：enable= 无法取反，靠「开着时被请求短路吞掉」实现二选一。
#      顺带成了安全网 —— 万一请求短路没生效，这里仍会去广告，只是没省到流量。
http-response ^https://(?:grpc\.biliapi\.net|app\.bili(?:bili\.com|api\.net))/bilibili\.app\.viewunite\.v1\.View/AIRelateAsync$ script-path=https://raw.githubusercontent.com/orangespiring/apple_scripts/main/scripts/BilibiliShortCircuit.js, requires-body=true, binary-body-mode=true, argument=[{logLevel}], tag=B站·相关视频·去广告保留推荐

# — 请求侧（上游 Sparkle，直引）—

# 空降助手
http-request ^https://(?:grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.community\.service\.dm\.v1\.DM/DmSegMobile$ script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, argument=[{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={sponsorBlock}, tag=B站·空降助手

# 评论区加载优化
http-request ^https://(?:grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.(?:app\.viewunite\.v1\.View/View|main\.community\.reply\.v1\.Reply/MainList)$ script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, argument=[{purifyComment},{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={optimizeRequest}, tag=B站·评论区加载优化

# 直播间去广告
http-response ^https://api\.live\.bilibili\.com/xlive/(?:app-interface/v2/index/feed|app-room/v1/index/getInfoBy(?:Room|User))\? script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js, requires-body=true, tag=B站·直播间去广告

# ===== 重写 =====
[Rewrite]

# 直播带货 / 游戏直播大卡
^https://api\.live\.bilibili\.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info\? reject-dict
^https://line3-h5-mobile-api\.biligame\.com/game/live/large_card_material\? reject-dict

# 开屏品牌 / 顶栏活动 / 会员广告 / 搜索热搜
^https://ap[ip]\.bilibili\.com/x/(?:resource/(?:top/activity|patch/tab(?:/v2)?)|v2/search/square|vip/ads/materials)\? mock-response-body data-type=text status-code=200 data="{"code":-404,"message":"-404","ttl":1,"data":null}"
^https://api\.bilibili\.com/pgc/activity/deliver/material/receive\? mock-response-body data-type=text status-code=200 data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"

# ⭐ AIRelateAsync = 详情页「相关视频」的真正来源（`179_` 实测，2026-08-29）。它一个响应里装两样东西：
#   · field 1 = 广告 bilibili.ad.v1.AdsControlDto，带 openapp.jdmobile/taobao/tmall/pinduoduo/
#     vipshop/imeituan 的唤起白名单 → 能自动拉起购物 App（用户报的「自动跳转」多半是它）
#   · field 2 = 121 KB 的相关视频列表（带「我不想看/不感兴趣」菜单的标准推荐卡）
#   插件原先只处理 RelatesFeed（`179_` 里已被清成 21 B），内容却全走这条 → 列表照常出现。
#   📌 2026-09-08 起 **AIRelateAsync 已从下面这两条 mock 里移出**，改由 [Script] 按 cleanRelates 分流
#      （见上方「相关视频·去广告保留推荐」）。原先它是恒开 mock，导致关掉 cleanRelates 也没有推荐、
#      开关名不副实（desc 写的是「关=仅去广告、保留推荐」）。
# gRPC mock（青少年弹窗 / 默认搜索 / TFInfo / 结束页 / 暂停页）
^https://grpc\.biliapi\.net/bilibili\.app\.interface\.v1\.Teenagers/ModeStatus$ mock-response-body data-type=text data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA" mock-data-is-base64=true
^https://grpc\.biliapi\.net/bilibili\.app\.interface\.v1\.Search/DefaultWords$ mock-response-body data-type=text data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=" mock-data-is-base64=true
^https://grpc\.biliapi\.net/bilibili\.app\.(?:view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))$ mock-response-body data-type=text data="AAAAAAA=" mock-data-is-base64=true
^https://grpc\.biliapi\.net/bilibili\.app\.(?:interface\.v1\.(?:Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(?:PlayPause|ViewEndPage))$ response-header-add grpc-status 0

# 详情页弹窗广告（`176_` 实测；纪录片/番剧这类 PGC 页最容易触发）
#   · mall-dayu/muggle/iam = 会员购 in-app message，实测下发 maStyleType=COUPON_POPUP
#     「新人专享10元现货运费券」整套弹窗数据 → reject 掉就没弹窗
#   · x/vip/activity/popup/info = VIP 活动弹窗（`176_` 里恰好 data:null，但它就是弹窗数据源）
#   · 配套的 VipRetentionPopupH5 / VipLoginPopupH5 / OgvVipBuyBase 是 s1.hdslb.com 上的静态 H5，
#     不直接拦静态件（易误伤且随时改名），拦上面这两个下发数据的接口即可
^https://mall\.bilibili\.com/mall-dayu/muggle/iam reject-dict
^https://api\.bilibili\.com/x/vip/(?:activity/popup/info|gsm/activity/preload) reject-dict

# 皮肤装扮广告位
^https://app\.bilibili\.com/x/resource/show/skin\? response-body-json-del data.common_equip

# 开屏品牌/活动/曝光（脚本接管 splash/list，这里兜底其余）
^https?://app\.bili(?:bili\.com|api\.net)/x/v2/splash/(?:brand/list|event/list2|show) reject-200

# 杂项广告/追踪
^https://(?:api\.bilibili\.com/x/mengqi/v1/resource|app\.bilibili\.com/x/resource/peak/download) reject-dict
^https://api\.bilibili\.com/x/v2/dm/qoe/show\? reject-dict
^https://app\.bilibili\.com/x/resource/ip reject-dict

# 剥离分享链接追踪参数
(^https://live\.bilibili\.com/\d+)(/?\?.*) 307 $1
(^https://(?:www|m)\.bilibili\.com/video/(?:BV\w{10}|av\d{9}))(/?\?.*) 307 $1

# ===== MITM =====
[MITM]
# ⚠️ mall.bilibili.com 是为了那条 mall-dayu/muggle/iam 弹窗规则加的——不 MITM 它，
#    [Rewrite] 看不到 https 的路径，规则就是静默失效。只拦这一个路径，会员购其余功能不受影响。
hostname = ap?.bilibili.com, app.biliapi.net, grpc.biliapi.net, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com, m.bilibili.com, live.bilibili.com, mall.bilibili.com
